msgid "%(duration_minutes)s мин"
msgstr "%(duration_minutes)s мин"

msgid "%(name)s может войти заново и продолжить тест"
msgstr "%(name)s қайта кіріп, тестті жалғастыра алады"

msgid "%(name)s может пройти тест заново до %(until)s"
msgstr "%(name)s тестті %(until)s дейін қайта тапсыра алады"

msgid "%(number)s из %(num_pages)s"
msgstr "%(number)s / %(num_pages)s"

msgid "%(score)s из %(max_score)s"
msgstr "%(score)s / %(max_score)s"

msgid "(если есть)"
msgstr "(бар болса)"

msgid ", без ответа"
msgstr ", жауапсыз"

msgid ", группы %(groups)s"
msgstr ", топтар %(groups)s"

msgid ", каждые 5 секунд"
msgstr ", әр 5 секунд сайын"

msgid ", с замечаниями:"
msgstr ", ескертулермен:"

