{
  "manifest_version": 3,
  "name": "Адал Guard",
  "short_name": "Адал Guard",
  "version": "1.0.0",
  "description": "Защита экзамена на платформе Адал: пока идёт тест, браузер открывает только Адал, а ИИ-сервисы и новые вкладки заблокированы.",
  "minimum_chrome_version": "116",
  "permissions": ["declarativeNetRequest", "tabs", "storage", "management", "webNavigation", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://adal-murex.vercel.app/*", "http://127.0.0.1/*", "http://localhost/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.css"], "matches": ["<all_urls>"] }],
  "action": {
    "default_title": "Адал Guard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
